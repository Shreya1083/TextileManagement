// Textile ERP - Database Schema
// Authentication, User Management, and ERP Domains

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String
  role              Role     @default(STOREKEEPER)
  isActive          Boolean  @default(true)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  passwordChangedAt DateTime?
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  sessions UserSession[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String
  token     String   @db.Text
  userAgent String?
  ipAddress String?
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("user_sessions")
}

enum Role {
  OWNER
  STOREKEEPER
  SUPERVISOR
  INSPECTOR
  ACCOUNTS
  BUYER
  WORKER
}

// ============================================
// ERP MODELS
// ============================================

model Customer {
  id           String   @id @default(cuid())
  buyerId      String?  @unique @default(cuid())
  name         String
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  type         String?
  gstin        String?
  pan          String?
  creditLimit  Float?
  paymentTerms String?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("customers")
}

model Order {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  name        String
  phone       String?
  email       String?
  role        String
  department  String?  @default("Production")
  shift       String?  @default("Morning")
  wageBasis   WageBasis
  dailyWage   Int?     // in paise
  pieceRate   Int?     // in paise
  isActive    Boolean  @default(true)
  joinDate    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  rolls    Roll[]

  @@map("orders")
}

model Machine {
  id        String   @id @default(cuid())
  machineId String   @unique // M-01, M-02
  name      String
  stage     String   // Spinning, Weaving, Dyeing, Finishing
  status    String   // RUNNING, IDLE, BREAKDOWN
  output    Int      @default(0)
  operator  String?
  order     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolls     Roll[]
  productionEntries ProductionEntry[]
  downtimes         Downtime[]

  @@map("machines")
}

model Downtime {
  id        String   @id @default(cuid())
  machineId String
  reason    String
  status    String   @default("OPEN") // OPEN, RESOLVED
  start     DateTime @default(now())
  end       DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine   Machine  @relation(fields: [machineId], references: [machineId])

  @@map("downtimes")
}

model ProductionEntry {
  id        String   @id @default(cuid())
  date      DateTime
  shift     String
  machineId String
  orderId   String?
  output    Float
  waste     Float
  rolls     Int
  operator  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine   Machine  @relation(fields: [machineId], references: [machineId])

  @@map("production_entries")
}

model Roll {
  id          String   @id @default(cuid())
  rollNumber  String   @unique
  orderId     String
  machineId   String
  length      Float
  status      String   // AWAITING_QC, PASSED, REWORK, REJECTED
  inspector   String?
  producedAt  DateTime
  defects     String?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])

  @@map("rolls")
}

model InventoryItem {
  id        String   @id @default(cuid())
  type      String   // Cotton 40s, Poly 150D
  color     String
  current   Float
  reserved  Float
  reorder   Float
  unit      String   // kg, m
  status    String   // OK, LOW, OUT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  bomItems  BOMItem[]

  @@map("inventory_items")
}

model BOM {
  id          String   @id @default(cuid())
  bomId       String   @unique
  productName String
  fabric      String
  color       String
  
  items       BOMItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("boms")
}

model BOMItem {
  id          String   @id @default(cuid())
  bomId       String
  inventoryId String
  quantity    Float    // Amount required per unit (e.g. per meter)
  
  bom         BOM           @relation(fields: [bomId], references: [id])
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id])
  
  @@map("bom_items")
}

model Worker {
  id        String   @id @default(cuid())
  workerId  String   @unique
  name      String
  role      String
  dept      String
  wage      Float
  basis     String
  shift     String?
  contact   String?
  email     String?
  rfidUid   String?
  machineId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  attendances Attendance[]

  @@map("workers")
}

model Attendance {
  id        String   @id @default(cuid())
  workerId  String
  date      DateTime
  status    String   // P, A, H, S
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  worker    Worker   @relation(fields: [workerId], references: [workerId], onDelete: Cascade)

  @@unique([workerId, date])
  @@map("attendance")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  city          String
  state         String?
  phone         String
  altPhone      String?
  email         String?
  gstin         String?
  pan           String?
  website       String?
  yarnTypes     String?
  leadDays      String?
  paymentTerms  String?
  notes         String?
  activePos     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("suppliers")
}

model Dispatch {
  id        String   @id @default(cuid())
  dispatchId String  @unique
  buyer     String
  order     String
  rolls     Int
  metres    Float
  date      DateTime
  vehicle   String?
  driver    String?
  status    String   // PENDING, DISPATCHED, DELIVERED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dispatches")
}

model Invoice {
  id        String   @id @default(cuid())
  invoiceId String   @unique
  buyer     String
  dispatch  String
  amount    Float
  paid      Float
  balance   Float
  date      DateTime
  status    String   // PARTIAL, UNPAID, PAID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}




model GateEntry {
  id        String   @id @default(cuid())
  grnId     String   @unique @default(cuid())
  supplier  String
  yarn      String
  colour    String?
  lotBatch  String?
  qty       Float
  bags      Int
  challan   String
  vehicle   String
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gate_entries")
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  poId      String   @unique @default(cuid())
  supplier  String
  yarn      String
  qty       Float
  rate      Float
  total     Float
  expected  DateTime
  status    String   // RAISED, PARTIALLY_RECEIVED, RECEIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchase_orders")
}


model MillSetting {
  id            String   @id @default(cuid())
  name          String
  address       String
  gstin         String
  invoicePrefix String
  currency      String   @default("INR (₹)")
  timezone      String   @default("Asia/Kolkata (IST +05:30)")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("mill_settings")
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // e.g., 'announcement', 'machine-down', 'low-stock'
  message   String
  severity  String   // e.g., 'info', 'warning', 'danger'
  author    String   @default("System")
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Settings {
  id             String   @id @default("singleton")
  stages         String[] @default(["Spinning", "Weaving", "Dyeing", "Finishing"])
  fabrics        String[] @default(["Cotton Voile", "Linen Blend", "Silk Chiffon", "Denim", "Poly Cotton", "Georgette"])
  defects        String[] @default(["Colour Mismatch", "Uneven Weave", "Stain", "Hole", "Other"])
  attendanceOpen Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@map("settings")
}
